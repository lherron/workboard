{
  "name": "@workboard/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json --emitDeclarationOnly --declaration --outDir dist",
    "lint": "echo 'lint not configured for shared'",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "format": "prettier --check src",
    "format:write": "prettier --write src"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
